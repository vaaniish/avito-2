DATABASE_URL=postgresql://user:password@127.0.0.1:5433/avito-db?schema=public
PORT=3001
NODE_ENV=development

# Local development. Production template: infra/production.env.example.
CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
TRUST_PROXY=false

# Server-side sessions and PostgreSQL pool.
AUTH_SESSION_TTL_MS=86400000
AUTH_REMEMBERED_SESSION_TTL_MS=2592000000
AUTH_SESSION_PRUNE_INTERVAL_MS=60000
PG_POOL_MAX=10
PG_POOL_IDLE_TIMEOUT_MS=30000
PG_POOL_CONNECTION_TIMEOUT_MS=5000
SHUTDOWN_TIMEOUT_MS=10000
METRICS_ACCESS_TOKEN=

# Used at frontend build time.
VITE_API_BASE_URL=http://127.0.0.1:3001/api
VITE_API_TIMEOUT_MS=12000
VITE_YANDEX_MAPS_API_KEY=
VITE_YANDEX_GEOSUGGEST_API_KEY=

# Demo-safe placeholders. Fill only with test credentials, never personal keys.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_WEBHOOK_TOKEN=
YOOKASSA_WEBHOOK_IP_ALLOWLIST=127.0.0.1

DADATA_API_BASE_URL=
DADATA_API_KEY=
DADATA_SECRET_KEY=
DADATA_TIMEOUT_MS=5000

YANDEX_DELIVERY_BASE_URL=
YANDEX_DELIVERY_TOKEN=
YANDEX_DELIVERY_OPERATOR_IDS=
YANDEX_DELIVERY_SOURCE_STATION_ID=
YANDEX_DELIVERY_TIMEOUT_MS=5000
YANDEX_DELIVERY_TEST_BASE_URL=
YANDEX_DELIVERY_TEST_TOKEN=
YANDEX_DELIVERY_TEST_SOURCE_STATION_ID=
YANDEX_DELIVERY_TEST_TIMEOUT_MS=5000
YANDEX_ORG_SEARCH_API_KEY=

GOOGLE_CLOUD_PROJECT=

PASSWORD_HASH_SALT_ROUNDS=12
HTTP_SLOW_REQUEST_MS=1200
CATALOG_CACHE_TTL_MS=15000
HTTP_LOG_SAMPLE_RATE=1
LISTING_MODERATION_CONCURRENCY=4
IMAGE_STORAGE_DRIVER=inline
BACKUP_RETENTION_DAYS=7

RATE_LIMIT_AUTH_LOGIN_WINDOW_MS=900000
RATE_LIMIT_AUTH_LOGIN_MAX=50
RATE_LIMIT_AUTH_SIGNUP_WINDOW_MS=900000
RATE_LIMIT_AUTH_SIGNUP_MAX=20
RATE_LIMIT_CHECKOUT_WINDOW_MS=600000
RATE_LIMIT_CHECKOUT_MAX=60
RATE_LIMIT_PARTNER_WRITE_WINDOW_MS=600000
RATE_LIMIT_PARTNER_WRITE_MAX=120
RATE_LIMIT_ADMIN_WRITE_WINDOW_MS=600000
RATE_LIMIT_ADMIN_WRITE_MAX=120

# Local demo implementations; no real payments or bank requests.
PAYMENT_USE_LOCAL_STUB=1
DADATA_USE_LOCAL_BANK_FIXTURES=1
