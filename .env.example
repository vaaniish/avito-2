DATABASE_URL=postgresql://user:password@127.0.0.1:5432/avito-db-dev?schema=public
PORT=3001
NODE_ENV=production

# Public URL where the frontend is opened by the reviewer.
CORS_ALLOWED_ORIGINS=https://demo.example.com
TRUST_PROXY=1

# Generate a unique 32+ char value for every demo/prod stand.
SESSION_TOKEN_SECRET=change-me-to-a-long-random-demo-secret
SESSION_TOKEN_ISSUER=avito-2-backend
SESSION_TOKEN_AUDIENCE=avito-2-frontend

# Used at frontend build time.
VITE_API_BASE_URL=https://demo.example.com/api
VITE_API_TIMEOUT_MS=12000
VITE_YANDEX_MAPS_API_KEY=
VITE_YANDEX_GEOSUGGEST_API_KEY=

# Demo-safe placeholders. Fill only with test credentials, never personal keys.
YOOKASSA_SHOP_ID=demo-shop
YOOKASSA_SECRET_KEY=demo-secret
YOOKASSA_WEBHOOK_TOKEN=demo-webhook-token
YOOKASSA_WEBHOOK_IP_ALLOWLIST=127.0.0.1

DADATA_API_BASE_URL=
DADATA_API_KEY=
DADATA_SECRET_KEY=
DADATA_TIMEOUT_MS=5000

YANDEX_DELIVERY_BASE_URL=
YANDEX_DELIVERY_TOKEN=
YANDEX_DELIVERY_OPERATOR_IDS=
YANDEX_DELIVERY_SOURCE_STATION_ID=
YANDEX_DELIVERY_TIMEOUT_MS=5000
YANDEX_DELIVERY_TEST_BASE_URL=
YANDEX_DELIVERY_TEST_TOKEN=
YANDEX_DELIVERY_TEST_SOURCE_STATION_ID=
YANDEX_DELIVERY_TEST_TIMEOUT_MS=5000
YANDEX_ORG_SEARCH_API_KEY=

GOOGLE_CLOUD_PROJECT=

PASSWORD_HASH_SALT_ROUNDS=10
HTTP_SLOW_REQUEST_MS=1200

RATE_LIMIT_AUTH_LOGIN_WINDOW_MS=900000
RATE_LIMIT_AUTH_LOGIN_MAX=50
RATE_LIMIT_AUTH_SIGNUP_WINDOW_MS=900000
RATE_LIMIT_AUTH_SIGNUP_MAX=20
RATE_LIMIT_CHECKOUT_WINDOW_MS=600000
RATE_LIMIT_CHECKOUT_MAX=60
RATE_LIMIT_PARTNER_WRITE_WINDOW_MS=600000
RATE_LIMIT_PARTNER_WRITE_MAX=120
RATE_LIMIT_ADMIN_WRITE_WINDOW_MS=600000
RATE_LIMIT_ADMIN_WRITE_MAX=120
